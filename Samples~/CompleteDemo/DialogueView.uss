.dialogue {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 8%;
    padding: 18px;
    background-color: rgba(10, 12, 18, 0.92);
}

.speaker {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(126, 204, 224);
}

.line {
    margin-top: 8px;
    font-size: 16px;
    color: rgb(235, 235, 228);
}

.choices {
    margin-top: 12px;
}
